---
/**
 * Procedência das fontes do estudo (o percurso em quatro chips foi removido).
 */
import { NOTA_FONTES } from "../data/fluxo";

const RONI_URL = "https://www.cpc.ncep.noaa.gov/data/indices/RONI.ascii.txt";
---

<p class="m-0 text-[13px] leading-[1.4] text-data-neutral xl:text-[14px]">
  {NOTA_FONTES}{" "}
  <a
    class="underline underline-offset-2 transition-colors hover:text-accent"
    href={RONI_URL}
    target="_blank"
    rel="noopener noreferrer">NOAA/CPC — RONI (ASCII)</a
  >
</p>
