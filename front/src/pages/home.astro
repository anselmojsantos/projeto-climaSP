---
import Base from "../layouts/Base.astro";
import Home from "../components/home";
import { getRotaPorSlug } from "../config/rotas";

const baseApi = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3333";
const rota = getRotaPorSlug("home");
const titulo = rota.titulo;
---

<Base titulo={titulo}>
  <Home client:load baseApi={baseApi} />
</Base>
