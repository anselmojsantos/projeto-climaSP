---
import Base from "../layouts/Base.astro";
import Noaa from "../components/noaa";
import { getRotaPorSlug } from "../config/rotas";

const baseApi = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3333";
const rota = getRotaPorSlug("dados-noaa");
const titulo = rota.titulo;
---

<Base titulo={titulo}>
  <Noaa client:only="react" baseApi={baseApi} />
</Base>
