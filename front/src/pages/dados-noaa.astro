---
import Base from "../layouts/Base.astro";
import Noaa from "../components/noaa";
import { SECOES } from "../types/secoes";

const titulo = SECOES.find((secao) => secao.slug === "dados-noaa")!.titulo;
const baseApi = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3333";
---

<Base titulo={titulo}>
  <Noaa client:load baseApi={baseApi} />
</Base>
